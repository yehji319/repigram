{
  "name": "repigram-api",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "Counter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  "vars": {
    // 이 주소에서 오는 요청만 받아요
    "ALLOWED_ORIGINS": "https://yehji319.github.io,https://repigram.com,https://www.repigram.com,http://localhost:5173",
    // Supabase 프로젝트 주소와 공개(anon) 키 — 공개돼도 되는 값 (데이터는 RLS로 보호)
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": "",
    // 사진·글 AI 정리: 계정당 하루 횟수
    "FREE_DAILY_AI": "10",
    "PREMIUM_DAILY_AI": "30",
    // 영상 분석: 프리미엄 계정당 한 달 횟수, 최대 영상 길이(분) — 구독료를 낮게 유지하기 위해 적게
    "PREMIUM_MONTHLY_VIDEO": "10",
    "MAX_VIDEO_MINUTES": "15",
    // 전체 사용자 합계 하루 한도 (요금 폭탄 방지용 마지막 안전장치)
    "GLOBAL_DAILY_AI": "3000",
    "GLOBAL_DAILY_VIDEO": "300"
  }
  // 비밀값은 여기 적지 말고 터미널에서 등록:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  //   npx wrangler secret put GEMINI_API_KEY
  //   npx wrangler secret put YOUTUBE_API_KEY
}
